Fix segmentation fault when unserializing a nonexistent or non-case enum member.
msgpack_unserialize() dereferenced the result of zend_enum_get_case() without
checking the case exists, crashing on crafted or stale session data.

Upstream: https://github.com/msgpack/msgpack-php/commit/b6e1202d78
Upstream: https://github.com/msgpack/msgpack-php/commit/26c8c704b3

diff --git a/msgpack_unpack.c b/msgpack_unpack.c
index 88387e5..df33d7b 100644
--- a/msgpack_unpack.c
+++ b/msgpack_unpack.c
@@ -712,6 +712,19 @@ int msgpack_unserialize_map_item(msgpack_unpack_data *unpack, zval **container,
                         return 0;
                     }
 
+                    /* found Enum does not contain specified case */
+                    zend_class_constant *constant = zend_hash_find_ptr(
+                        CE_CONSTANTS_TABLE(ce),
+                        Z_STR_P(val));
+                    if (constant == NULL || !(ZEND_CLASS_CONST_FLAGS(constant) & ZEND_CLASS_CONST_IS_CASE)) {
+                        MSGPACK_WARNING(
+                            "[msgpack] (%s) Enum case %s does not exist in Enum %s",
+                            __FUNCTION__, Z_STRVAL_P(val), ZSTR_VAL(ce->name));
+
+                        MSGPACK_UNSERIALIZE_FINISH_MAP_ITEM(unpack, key, val);
+                        return 0;
+                    }
+
                     zend_object *enum_instance = zend_enum_get_case(ce, Z_STR_P(val));
                     ZVAL_OBJ_COPY(*container, enum_instance);
 #endif
